# Server Port
PORT=5000

# Environment Mode: development | production
NODE_ENV=development

# MongoDB Connection String
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Client Origin (Main Frontend URL)
CLIENT_ORIGIN=http://localhost:3000

# Allowed CORS Origins (comma-separated list for backend and socket)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Development / Socket Backend Target
VITE_BACKEND_URL=http://localhost:5000

# (Optional) Frontend API Base URL (leave blank to use relative proxy / same-origin)
VITE_API_BASE_URL=

